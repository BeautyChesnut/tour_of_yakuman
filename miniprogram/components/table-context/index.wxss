.table-context {
  padding: 22rpx;
  border-radius: 8rpx;
  background: #184c3a;
  color: #fff;
}

.middle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0;
}

.seat {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 64rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
}

.north,
.south {
  margin: 0 auto;
}

.winner {
  background: #f5c542;
  color: #1f2933;
}

.dealer {
  border-color: #fff;
}

.discarder {
  box-shadow: inset 0 0 0 2rpx #d8543f;
}

.role {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1;
}

.center {
  min-width: 220rpx;
  text-align: center;
}

.round {
  font-size: 30rpx;
  font-weight: 700;
}

.meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.85;
}
