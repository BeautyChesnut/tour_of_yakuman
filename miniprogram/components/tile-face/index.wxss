.tile-face {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 44rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid transparent;
  border-radius: 7rpx;
  background-color: transparent;
  background-image: none;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  box-shadow: none;
  color: #1f2933;
  text-align: center;
}

.tile-face.empty {
  border-color: rgba(82, 99, 89, 0.28);
  border-style: dashed;
  background-color: transparent;
  background-image: none;
  box-shadow: none;
  color: #9aa19a;
}

.tile-face.active {
  border-color: #126c4f;
  box-shadow: 0 0 0 2rpx rgba(18, 108, 79, 0.2);
}

.tile-face.winning {
  border-color: #9f2a2a;
  background-color: transparent;
  background-image: none;
}

.tile-image {
  display: block;
  width: 100%;
  height: 100%;
}

.tile-main {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.tile-suit {
  display: block;
  margin-top: -2rpx;
  font-size: 14rpx;
  line-height: 16rpx;
}

.tile-face.compact .tile-main {
  font-size: 22rpx;
  line-height: 29rpx;
}

.tile-face.compact .tile-suit {
  font-size: 13rpx;
  line-height: 15rpx;
}

.tile-face.normal .tile-main {
  font-size: 30rpx;
  line-height: 36rpx;
}

.tile-face.normal .tile-suit {
  font-size: 16rpx;
}

.suit-m .tile-main,
.suit-m .tile-suit,
.dragon-red .tile-main,
.red-five .tile-main {
  color: #b42318;
}

.suit-p .tile-main,
.suit-p .tile-suit {
  color: #1d5fa7;
}

.suit-s .tile-main,
.suit-s .tile-suit,
.dragon-green .tile-main {
  color: #167044;
}

.honor .tile-main {
  color: #1f2933;
}
