page {
  min-height: 100%;
  background: #f5f3ed;
  color: #1f2933;
}

.analysis-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  box-sizing: border-box;
}

.analysis-overview {
  padding: 28rpx;
  border: 1rpx solid #d8e4dc;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(24, 76, 58, 0.07);
}

.overview-label,
.overview-rank,
.overview-meta,
.target-status-title,
.target-status-copy,
.section-title,
.detail-line,
.detail-muted,
.empty-title,
.empty-copy {
  display: block;
}

.overview-label {
  color: #667085;
  font-size: 22rpx;
  font-weight: 700;
}

.overview-rank {
  margin-top: 6rpx;
  color: #184c3a;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.overview-meta {
  margin-top: 14rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 34rpx;
}

.freshness-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 64rpx;
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  border: 1rpx solid #d8e4dc;
  border-radius: 6rpx;
  box-sizing: border-box;
  background: #edf5f0;
}

.freshness-text {
  flex: 1;
  min-width: 0;
  color: #476157;
  font-size: 20rpx;
  line-height: 30rpx;
}

.freshness-warning {
  border-color: #e9bd83;
  background: #fff5e8;
}

.freshness-warning .freshness-text {
  color: #8a4b16;
}

.freshness-syncing .freshness-text {
  color: #52606d;
}

.freshness-button {
  width: 104rpx;
  min-width: 104rpx;
  height: 44rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 6rpx;
  background: #184c3a;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.freshness-button::after {
  border: 0;
}

.perspective-control {
  margin-top: 18rpx;
}

.perspective-label {
  display: block;
  margin-bottom: 10rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.perspective-options {
  display: grid;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 8rpx;
  background: #e5e9e5;
}

.perspective-options-three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.perspective-options-four {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.perspective-option {
  min-width: 0;
  padding: 14rpx 6rpx;
  overflow: hidden;
  border-radius: 6rpx;
  color: #667085;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.perspective-option-active {
  background: #184c3a;
  color: #fff;
}

.strategy-context {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #2f7255;
  background: #eef5f0;
}

.strategy-context-heading,
.decision-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.decision-heading-copy {
  flex: 1;
  min-width: 0;
}

.strategy-context-title,
.strategy-context-line,
.strategy-context-rule,
.decision-subtitle,
.decision-result-title,
.decision-copy,
.tenpai-option-name,
.tenpai-option-state {
  display: block;
}

.strategy-context-title {
  color: #184c3a;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.strategy-context-badge,
.decision-status {
  flex: 0 0 auto;
  padding: 3rpx 10rpx;
  border-radius: 4rpx;
  background: #d9ebdf;
  color: #236748;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.decision-status {
  display: flex;
  min-width: 92rpx;
  height: 44rpx;
  padding: 0 10rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
}

.strategy-context-line,
.strategy-context-rule {
  margin-top: 8rpx;
  color: #4d5c55;
  font-size: 21rpx;
  line-height: 34rpx;
}

.strategy-context-rule {
  color: #7a5c23;
  font-weight: 800;
}

.target-tabs {
  display: grid;
  gap: 8rpx;
  margin-top: 22rpx;
  padding: 6rpx;
  border-radius: 8rpx;
  background: #e5e9e5;
}

.target-tabs-two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.target-tabs-three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.target-tabs-four {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.target-tab {
  min-width: 0;
  padding: 18rpx 6rpx;
  border-radius: 6rpx;
  color: #667085;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-align: center;
}

.target-tab-active {
  background: #184c3a;
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(24, 76, 58, 0.18);
}

.target-content {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e0e3df;
  border-radius: 8rpx;
  background: #fff;
}

.decision-section {
  margin-top: 22rpx;
  padding: 26rpx 2rpx 0;
  border-top: 2rpx solid #dfe5e1;
}

.decision-subtitle {
  margin-top: 5rpx;
  color: #7a8580;
  font-size: 19rpx;
  line-height: 30rpx;
}

.decision-status-unavailable {
  background: #f8e5dc;
  color: #a34728;
}

.decision-result-title {
  margin-top: 20rpx;
  color: #184c3a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.decision-copy {
  margin-top: 7rpx;
  color: #55625c;
  font-size: 21rpx;
  line-height: 34rpx;
}

.compact-result-table {
  background: #fff;
}

.tenpai-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.tenpai-option {
  min-width: 0;
  padding: 14rpx 16rpx;
  border: 1rpx solid #d9dfdb;
  border-radius: 6rpx;
  background: #fff;
}

.tenpai-option-active {
  border-color: #4d8f70;
  background: #e8f3ec;
}

.tenpai-option-name {
  overflow: hidden;
  color: #34443c;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tenpai-option-state {
  margin-top: 3rpx;
  color: #7a8580;
  font-size: 18rpx;
  line-height: 28rpx;
}

.tenpai-option-active .tenpai-option-state {
  color: #23704e;
  font-weight: 800;
}

.target-status {
  padding: 26rpx;
  background: #eef6f1;
}

.target-status-achieved {
  background: #f7f2df;
}

.target-status-warning {
  background: #fff1ee;
}

.target-status-title {
  color: #184c3a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.target-status-copy {
  margin-top: 8rpx;
  color: #46515f;
  font-size: 23rpx;
  line-height: 36rpx;
}

.analysis-section {
  padding: 24rpx 26rpx;
  border-top: 1rpx solid #edf0ec;
}

.section-title {
  color: #46515f;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.detail-line,
.detail-muted {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 38rpx;
}

.detail-line {
  color: #1f2933;
}

.detail-muted {
  color: #8b968f;
}

.scenario-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #dce7df;
  border-radius: 6rpx;
  background: #f8fbf9;
}

.scenario-entry:active {
  background: #edf5f0;
}

.scenario-entry-risk {
  border-color: #ecd8d3;
  background: #fff9f7;
}

.scenario-copy {
  min-width: 0;
}

.scenario-title,
.scenario-description,
.scenario-result-name,
.scenario-result-rank,
.scenario-result-note {
  display: block;
}

.score-recommendations {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf0ec;
}

.score-recommendation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 72rpx;
  margin-top: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 6rpx;
  background: #f8faf8;
}

.recommendation-main,
.recommendation-score-wrap {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.recommendation-main {
  align-items: flex-start;
  gap: 5rpx;
}

.recommendation-tone {
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 26rpx;
}

.recommendation-minimum {
  background: #dff1e7;
  color: #126c4f;
}

.recommendation-alternative {
  background: #e9edf1;
  color: #53606d;
}

.recommendation-stable {
  background: #f6ead0;
  color: #8a5a12;
}

.recommendation-label {
  color: #24322d;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.recommendation-score-wrap {
  align-items: flex-end;
}

.recommendation-score,
.recommendation-payment {
  display: block;
  text-align: right;
}

.recommendation-score {
  color: #24322d;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.recommendation-payment {
  margin-top: 3rpx;
  color: #78827d;
  font-size: 18rpx;
  line-height: 28rpx;
}

.recommendation-note {
  display: block;
  margin-top: 12rpx;
  color: #8b968f;
  font-size: 18rpx;
  line-height: 30rpx;
}

.scenario-title {
  color: #24322d;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.scenario-description {
  margin-top: 4rpx;
  color: #68746e;
  font-size: 20rpx;
  line-height: 30rpx;
}

.scenario-chevron {
  flex: 0 0 22rpx;
  color: #6d887b;
  font-size: 38rpx;
  line-height: 38rpx;
}

.scenario-result {
  margin-top: 20rpx;
  padding: 26rpx;
  border: 2rpx solid #b9d2c3;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(24, 76, 58, 0.1);
}

.scenario-result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.scenario-result-name {
  margin-top: 5rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 30rpx;
}

.scenario-close {
  width: 48rpx;
  height: 48rpx;
  color: #68746e;
  font-size: 38rpx;
  line-height: 44rpx;
  text-align: center;
}

.scenario-result-rank {
  margin-top: 18rpx;
  color: #184c3a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.scenario-result-table {
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid #e1e6e2;
  border-radius: 6rpx;
}

.scenario-result-row {
  display: grid;
  grid-template-columns: 104rpx minmax(0, 1fr) 170rpx;
  align-items: center;
  min-height: 68rpx;
  padding: 0 18rpx;
  border-top: 1rpx solid #edf0ec;
  font-size: 22rpx;
}

.scenario-result-row:first-child {
  border-top: 0;
}

.scenario-result-row-current {
  background: #edf6f0;
  color: #126c4f;
  font-weight: 900;
}

.result-rank {
  color: #667085;
}

.result-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-points {
  text-align: right;
}

.scenario-result-note {
  margin-top: 14rpx;
  color: #8b968f;
  font-size: 18rpx;
  line-height: 30rpx;
}

.empty-state {
  margin-top: 160rpx;
  padding: 48rpx 32rpx;
  border-radius: 8rpx;
  background: #fff;
  text-align: center;
}

.empty-title {
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-copy {
  margin-top: 16rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 38rpx;
}

.back-button {
  width: 320rpx;
  margin-top: 30rpx;
  border-radius: 6rpx;
  background: #184c3a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}

.back-button::after {
  border: 0;
}

