<view class="page page-theme-{{activeThemeId}}">
  <view wx:if="{{showModeHome}}" class="mode-home">
    <view class="mode-hero">
      <image class="mode-hero-image" src="/assets/home/home-dingbu.jpg" mode="aspectFill" />
    </view>
    <view class="mode-action-list">
      <view class="mode-card mode-card-local" catchtap="handleEnterLocalMode">
        <view class="mode-card-icon-wrap">
          <image class="mode-card-icon" src="/assets/home/home-tu.jpg" mode="aspectFill" />
        </view>
        <view class="mode-card-copy">
          <text class="mode-card-title">本地算点</text>
          <text class="mode-card-desc">四麻 / 三麻，快速完成番符与点数</text>
        </view>
        <view class="mode-card-arrow">›</view>
      </view>
      <view
        class="mode-card mode-card-create {{onlineRoomLoading ? 'mode-card-disabled' : ''}}"
        catchtap="handleShowOnlineRoom"
      >
        <view class="mode-card-icon-wrap">
          <image class="mode-card-icon" src="/assets/home/home-dog1.jpg" mode="aspectFill" />
        </view>
        <view class="mode-card-copy">
          <text class="mode-card-title">创建房间</text>
          <text class="mode-card-desc">与朋友开始一局</text>
        </view>
        <view class="mode-card-arrow">›</view>
      </view>
      <view
        class="mode-card mode-card-join {{onlineRoomLoading ? 'mode-card-disabled' : ''}}"
        catchtap="handleShowJoinRoom"
      >
        <view class="mode-card-icon-wrap">
          <image class="mode-card-icon" src="/assets/home/home-dog2.jpg" mode="aspectFill" />
        </view>
        <view class="mode-card-copy">
          <text class="mode-card-title">加入房间</text>
          <text class="mode-card-desc">输入房号快速加入</text>
        </view>
        <view class="mode-card-arrow">›</view>
      </view>
      <text wx:if="{{onlineRoomStatusText}}" class="mode-status">{{onlineRoomStatusText}}</text>
    </view>
  </view>

  <view
    wx:elif="{{editing}}"
    class="workbench workbench-labeled {{activeThemeId === 'benji' ? 'workbench-benji' : ''}} {{activeThemeId === 'maple' ? 'workbench-maple' : ''}}"
    bindtouchstart="handleWorkbenchTouchStart"
    bindtouchmove="handleWorkbenchTouchMove"
    bindtouchend="handleWorkbenchTouchEnd"
    bindtouchcancel="handleWorkbenchTouchCancel"
  >
    <view class="context-bar">
      <view class="context-main">
        <view class="context-line context-round-line">
          <view
            wx:if="{{workbenchMode === 'local'}}"
            class="room-exit-trigger"
            aria-label="返回首页"
            bindtap="handleBackToModeHome"
          >
            <text class="round-label">{{gameVariantText}}</text>
            <text class="room-home-text">返回首页</text>
          </view>
          <view
            wx:elif="{{onlineRoomCodeInput}}"
            class="room-exit-trigger"
            aria-label="退出房间"
            bindtap="handleLeaveOnlineRoom"
          >
            <text class="round-label">{{onlineRoomCodeInput}}</text>
            <text class="room-exit-text">退出房间</text>
          </view>
          <text wx:else class="round-label">{{roundLabel}}</text>
        </view>
      </view>
      <view class="context-actions">
        <view
          class="context-tool"
          aria-label="{{workbenchMode === 'local' ? '玩家' : '房间成员'}}"
          bindtap="handleShowPlayers"
        >
          <image class="button-icon-image" src="/assets/icons/icon-players.svg" mode="aspectFit" />
          <text class="context-tool-label">{{workbenchMode === 'local' ? '人数' : '成员'}}</text>
        </view>
        <view
          wx:if="{{canShuffleOnlineSeats}}"
          class="context-tool context-tool-wide"
          aria-label="随机座位"
          bindtap="handleShuffleOnlineSeats"
        >
          <text class="context-tool-text">随机</text>
        </view>
        <view class="context-tool" aria-label="规则" bindtap="handleShowRules">
          <text class="context-tool-text">?</text>
          <text class="context-tool-label">帮助</text>
        </view>
        <view class="context-tool" aria-label="记录" bindtap="handleShowRecords">
          <image class="button-icon-image" src="/assets/icons/icon-record.svg" mode="aspectFit" />
          <text class="context-tool-label">记录</text>
        </view>
        <view class="context-tool" aria-label="回退" bindtap="handleRollback">
          <image class="button-icon-image" src="/assets/icons/icon-rollback.svg" mode="aspectFit" />
          <text class="context-tool-label">撤销</text>
        </view>
        <view class="context-tool context-tool-danger" aria-label="重置" bindtap="handleReset">
          <image class="button-icon-image" src="/assets/icons/icon-reset.svg" mode="aspectFit" />
          <text class="context-tool-label">重置</text>
        </view>
      </view>
    </view>

    <view class="table-zone">
      <image
        wx:if="{{activeThemeId === 'benji'}}"
        class="benji-table-background"
        src="/assets/benji/benji-zhuobu.jpg"
        mode="aspectFill"
      />
      <image
        wx:if="{{activeThemeId === 'benji'}}"
        class="benji-table-dog"
        src="/assets/benji/benji-dog-transparent.png"
        mode="aspectFit"
      />
      <image
        wx:if="{{activeThemeId === 'benji'}}"
        class="benji-table-cat"
        src="/assets/benji/benji-tu-transparent.png"
        mode="aspectFit"
      />
      <image
        wx:if="{{activeThemeId === 'maple'}}"
        class="maple-table-background"
        src="/assets/maple/maple-table.jpg"
        mode="aspectFill"
      />
      <view
        class="table-refresh-button table-theme-button"
        aria-label="选择皮肤，当前{{activeThemeName}}"
        bindtap="handleShowThemePicker"
      >
        <text class="table-theme-button-text">{{activeThemeName}}</text>
      </view>
      <view
        wx:for="{{tableSeats}}"
        wx:key="seat"
        class="seat-card {{item.className}}"
        data-seat="{{item.seat}}"
        bindtap="handleToggleRiichi"
      >
        <view class="seat-avatar-wrap">
          <view class="seat-heading">
            <view class="seat-identity">
              <state-badge type="seat" label="{{item.directionLabel}}" />
            </view>
            <view class="seat-badges">
              <text
                wx:for="{{item.statusBadges}}"
                wx:for-item="badge"
                wx:key="type"
                class="seat-status-badge seat-status-badge-{{badge.type}}"
              >{{badge.label}}</text>
            </view>
          </view>
          <image
            wx:if="{{item.avatarSpriteClass}}"
            class="seat-avatar maple-avatar-sprite {{item.avatarSpriteClass}}"
            src="/assets/maple/maple-players.jpg"
            mode="widthFix"
          />
          <image
            wx:else
            class="seat-avatar {{item.avatarClass}} {{activeThemeId === 'maple' ? 'maple-avatar-image' : ''}}"
            src="{{item.avatarSrc}}"
            mode="{{item.avatarMode}}"
            data-seat="{{item.seat}}"
            binderror="handleSeatAvatarError"
          />
        </view>
        <view wx:if="{{item.onlineStatusText}}" class="seat-invite-bar">
          <text class="seat-invite-text">{{item.onlineStatusText}}</text>
        </view>
        <button
          wx:if="{{item.onlineStatusText}}"
          class="seat-invite-action"
          open-type="share"
          data-seat="{{item.seat}}"
          aria-label="{{item.onlineStatusText}}"
          catchtap="handleSeatInviteTap"
        />
        <block wx:else>
          <text class="seat-points">{{item.points}}</text>
          <text class="seat-rank">{{item.rankText}}</text>
          <text wx:if="{{item.nickname}}" class="seat-nickname">{{item.nickname}}</text>
        </block>
      </view>
      <view class="table-center">
        <text wx:for="{{tableCenterLines}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="settlement-zone">
      <view
        wx:for="{{summaryRows}}"
        wx:for-index="summaryIndex"
        wx:key="title"
        class="summary-row {{summaryIndex === summaryRows.length - 1 ? 'summary-row-last' : ''}} {{item.valueLines || item.tileSections ? 'summary-row-multiline' : ''}} {{item.tileSections ? 'summary-row-tiles' : ''}} {{item.valueTone === 'warning' ? 'summary-row-warning' : ''}}"
        data-panel="{{item.key}}"
        bindtap="handleOpenPanel"
      >
        <view class="summary-title-wrap">
          <image wx:if="{{item.iconSrc}}" class="summary-icon" src="{{item.iconSrc}}" mode="aspectFit" />
          <text class="summary-title">{{item.title}}</text>
        </view>
        <view wx:if="{{item.tileSections}}" class="summary-value summary-value-tiles">
          <view
            class="summary-tile-section"
            wx:for="{{item.tileSections}}"
            wx:for-item="section"
            wx:key="id"
          >
            <text class="summary-tile-label">{{section.label}}</text>
            <view class="summary-tile-list" wx:if="{{section.tiles.length}}">
              <view
                class="summary-tile"
                wx:for="{{section.tiles}}"
                wx:for-item="tileItem"
                wx:key="id"
              >
                <tile-face
                  tile="{{tileItem.tile}}"
                  label="{{tileItem.label}}"
                  winning="{{tileItem.winning}}"
                  size="compact"
                />
              </view>
            </view>
            <text wx:else class="summary-tile-empty">{{section.emptyText}}</text>
          </view>
        </view>
        <view wx:elif="{{item.valueLines}}" class="summary-value summary-value-lines">
          <text class="summary-value-line" wx:for="{{item.valueLines}}" wx:key="*this">{{item}}</text>
        </view>
        <text wx:else class="summary-value">{{item.value}}</text>
        <text
          wx:if="{{activeThemeId !== 'classic'}}"
          class="summary-chevron"
        >›</text>
      </view>

      <view
        wx:if="{{situationAnalysis.visible}}"
        class="situation-analysis-card {{situationAnalysis.available ? 'situation-analysis-card-actionable' : ''}}"
        bindtap="handleOpenSituationAnalysis"
      >
        <view class="situation-analysis-header">
          <view class="situation-analysis-heading">
            <text class="situation-analysis-title">局势分析</text>
            <text class="situation-analysis-badge">点数推演</text>
          </view>
          <text wx:if="{{situationAnalysis.available}}" class="situation-analysis-rank">
            {{situationAnalysis.rankingText}}
          </text>
        </view>

        <text wx:if="{{situationAnalysis.metaText}}" class="situation-analysis-meta">
          {{situationAnalysis.metaText}}
        </text>

        <view wx:if="{{!situationAnalysis.available}}" class="situation-analysis-empty">
          {{situationAnalysis.emptyText}}
        </view>

        <view wx:else class="situation-analysis-summary">
          <text class="situation-analysis-line">{{situationAnalysis.pressureText}}</text>
          <view class="situation-analysis-link">
            <text>查看升位与末位风险分析</text>
            <text class="situation-analysis-link-chevron">›</text>
          </view>
        </view>
      </view>

      <view class="error-panel" wx:if="{{errors.length}}">
        <view class="error-line" wx:for="{{errors}}" wx:key="*this">{{item}}</view>
      </view>

      <view class="multi-ron-bar" wx:if="{{multiRonProgress}}">
        <text>{{multiRonStatusText}}</text>
        <view class="multi-ron-actions">
          <button class="secondary-button compact-button" bindtap="handleMultiRonBack">回退上一名</button>
          <button class="secondary-button compact-button" bindtap="handleCancelMultiRon">取消多人荣和</button>
        </view>
      </view>

      <view class="settlement-primary-wrap">
        <button
          class="primary-button {{workbenchMode === 'room-viewer' ? 'primary-button-disabled' : ''}}"
          disabled="{{workbenchMode === 'room-viewer'}}"
          bindtap="handlePrepareSettlement"
        >
          {{workbenchMode === 'room-viewer' ? '确定结算 · 仅房主可编辑' : '确定结算'}}
        </button>
        <image
          wx:if="{{activeThemeId === 'benji'}}"
          class="benji-settlement-image"
          src="/assets/benji/benji-jiesuan-transparent.png"
          mode="aspectFit"
        />
        <image
          wx:if="{{activeThemeId === 'maple'}}"
          class="maple-settlement-leaves"
          src="/assets/maple/maple-button-leaves.png"
          mode="aspectFit"
        />
      </view>
    </view>
  </view>

  <view wx:else class="result-page">
    <scoring-result
      visible="{{true}}"
      title="本局结算"
      result="{{resultView}}"
      theme-id="{{activeThemeId}}"
    />
    <view class="result-actions">
      <button class="secondary-button result-action-button" bindtap="handleEditResult">返回修改</button>
      <button class="primary-button result-action-button" bindtap="handleNewInput">继续录入</button>
      <button
        class="secondary-button result-action-button result-share-button"
        open-type="share"
        data-share-context="result"
      >
        分享结果
      </button>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{editingPanel !== 'none'}}" bindtap="handleClosePanel"></view>

  <view class="bottom-sheet theme-sheet" wx:if="{{editingPanel === 'round-event'}}">
    <view class="sheet-header">
      <text class="sheet-title">本局事件</text>
    </view>

    <view class="segmented">
      <view
        wx:for="{{eventTypeOptions}}"
        wx:key="key"
        class="segment {{eventType === item.key ? 'segment-active' : ''}}"
        data-type="{{item.key}}"
        bindtap="handleEventTypeTap"
      >
        {{item.label}}
      </view>
    </view>

    <view wx:if="{{eventType !== 'draw'}}" class="event-choice-block">
      <text class="field-label">{{eventType === 'tsumo' ? '自摸者' : '和牌者'}}</text>
      <view class="role-choice-row">
        <view
          class="role-choice {{item.selected ? 'role-choice-selected role-choice-winner' : ''}} {{item.disabled ? 'role-choice-disabled' : ''}}"
          wx:for="{{winnerChoiceRows}}"
          wx:key="seat"
          data-seat="{{item.seat}}"
          bindtap="handleWinnerSeatTap"
        >
          <view class="role-mark">
            <text wx:if="{{item.mark}}">{{item.mark}}</text>
          </view>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{eventType === 'ron'}}" class="event-choice-block">
      <text class="field-label">放铳者</text>
      <view class="role-choice-row">
        <view
          class="role-choice {{item.selected ? 'role-choice-selected role-choice-discarder' : ''}} {{item.disabled ? 'role-choice-disabled' : ''}}"
          wx:for="{{discarderChoiceRows}}"
          wx:key="seat"
          data-seat="{{item.seat}}"
          bindtap="handleDiscarderSeatTap"
        >
          <view class="role-mark">
            <text wx:if="{{item.mark}}">{{item.mark}}</text>
          </view>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{eventType === 'draw'}}" class="checkbox-list">
      <view
        class="check-row tenpai-choice"
        wx:for="{{tenpaiRows}}"
        wx:key="seat"
        data-seat="{{item.seat}}"
        bindtap="handleTenpaiTap"
      >
        <view class="choice-circle {{item.checked ? 'choice-circle-checked' : ''}}">
          <text wx:if="{{item.checked}}">✓</text>
        </view>
        <text>{{item.label}}听牌</text>
      </view>
    </view>
  </view>

  <view class="bottom-sheet theme-sheet theme-picker-sheet" wx:if="{{editingPanel === 'theme'}}">
    <view class="sheet-header">
      <text class="sheet-title">桌面皮肤</text>
    </view>
    <view class="theme-option-list">
      <view
        wx:for="{{themeOptions}}"
        wx:key="id"
        class="theme-option {{item.selected ? 'theme-option-selected' : ''}} {{item.locked ? 'theme-option-locked' : ''}}"
        data-theme-id="{{item.id}}"
        bindtap="handleThemeSelect"
      >
        <image class="theme-option-preview" src="{{item.previewSrc}}" mode="aspectFill" />
        <view class="theme-option-copy">
          <view class="theme-option-heading">
            <text class="theme-option-name">{{item.name}}</text>
            <view class="theme-option-access theme-option-access-{{item.locked ? 'locked' : 'available'}}">
              {{item.accessText}}
            </view>
          </view>
          <text class="theme-option-description">{{item.description}}</text>
        </view>
        <text class="theme-option-state">
          {{item.selected ? '使用中' : item.locked ? '未解锁' : '选择'}}
        </text>
      </view>
    </view>
  </view>

  <view class="bottom-sheet online-themed-sheet online-create-sheet" wx:if="{{editingPanel === 'online-room'}}">
    <image class="online-themed-bg" src="/assets/home/online-join.jpg" mode="aspectFill" />
    <view class="online-themed-close" catchtap="handleClosePanel"></view>
    <view class="online-themed-figure online-create-figure">
      <image class="online-create-figure-image" src="/assets/home/online-join-icon.jpg" mode="aspectFit" />
    </view>
    <view class="online-themed-content">
      <text class="online-themed-title online-create-title">创建房间</text>
      <view class="online-themed-profile">
        <button
          class="online-avatar-button online-themed-avatar"
          open-type="chooseAvatar"
          bindchooseavatar="handleChooseOnlineAvatar"
        >
          <image
            wx:if="{{onlineProfileAvatarUrl}}"
            class="online-avatar-preview"
            src="{{onlineProfileAvatarUrl}}"
            mode="aspectFill"
          />
          <text wx:else>选头像</text>
        </button>
        <input
          class="online-profile-input"
          type="nickname"
          value="{{onlineProfileName}}"
          placeholder="填写微信昵称"
          maxlength="12"
          bindinput="handleOnlineProfileNameInput"
        />
      </view>
      <text class="online-themed-hint">首次设置后会在本机记住，下次自动带入</text>
      <button
        class="online-themed-submit online-create-submit"
        loading="{{onlineRoomLoading}}"
        disabled="{{onlineRoomLoading}}"
        bindtap="handleCreateOnlineRoom"
      >
        创建房间
      </button>
      <text wx:if="{{onlineRoomStatusText}}" class="online-room-status">{{onlineRoomStatusText}}</text>
    </view>
  </view>

  <view class="bottom-sheet online-themed-sheet online-join-sheet" wx:if="{{editingPanel === 'join-room'}}">
    <image class="online-themed-bg" src="/assets/home/online-create.jpg" mode="aspectFill" />
    <view class="online-themed-close" catchtap="handleClosePanel"></view>
    <view class="online-themed-figure online-join-figure">
      <image class="online-join-figure-image" src="/assets/home/online-icon-create.jpg" mode="aspectFit" />
    </view>
    <view class="online-themed-content">
      <text class="online-themed-title online-join-title">加入在线房间</text>
      <view class="online-themed-profile">
        <button
          class="online-avatar-button online-themed-avatar"
          open-type="chooseAvatar"
          bindchooseavatar="handleChooseOnlineAvatar"
        >
          <image
            wx:if="{{onlineProfileAvatarUrl}}"
            class="online-avatar-preview"
            src="{{onlineProfileAvatarUrl}}"
            mode="aspectFill"
          />
          <text wx:else>选头像</text>
        </button>
        <input
          class="online-profile-input"
          type="nickname"
          value="{{onlineProfileName}}"
          placeholder="填写微信昵称"
          maxlength="12"
          bindinput="handleOnlineProfileNameInput"
        />
      </view>
      <text class="online-themed-hint">首次设置后会在本机记住，下次自动带入</text>
      <view class="online-code-row">
        <input
          class="online-room-input join-room-input online-themed-code-input"
          value="{{onlineRoomCodeInput}}"
          placeholder="输入 6 位房间码"
          maxlength="6"
          type="number"
          bindinput="handleOnlineRoomCodeInput"
        />
      </view>
      <button
        class="online-themed-submit online-join-submit"
        loading="{{onlineRoomLoading}}"
        disabled="{{onlineRoomLoading}}"
        bindtap="handleJoinOnlineRoom"
      >
        加入房间
      </button>
      <text wx:if="{{onlineRoomStatusText}}" class="online-room-status">{{onlineRoomStatusText}}</text>
    </view>
  </view>

  <view class="bottom-sheet theme-sheet" wx:if="{{editingPanel === 'players'}}">
    <view class="sheet-header">
      <text class="sheet-title">{{workbenchMode === 'local' ? '玩家设置' : '房间成员'}}</text>
    </view>
    <view class="player-name-list" wx:if="{{workbenchMode === 'local'}}">
      <view class="player-name-row" wx:for="{{playerNameRows}}" wx:key="seat">
        <view class="player-name-meta">
          <state-badge type="seat" label="{{item.directionLabel}}" />
          <text>{{item.label}}</text>
        </view>
        <input
          class="player-name-input"
          value="{{item.name}}"
          placeholder="{{item.placeholder}}"
          maxlength="12"
          data-seat="{{item.seat}}"
          bindinput="handlePlayerNameInput"
          bindblur="handlePlayerNameBlur"
        />
      </view>
    </view>
    <view class="online-member-list" wx:else>
      <view class="online-member-row" wx:for="{{onlineRoomMemberRows}}" wx:key="openId">
        <view class="online-member-avatar-wrap">
          <image
            wx:if="{{item.avatarUrl}}"
            class="online-member-avatar"
            src="{{item.avatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="online-member-avatar online-member-avatar-fallback">
            {{item.directionLabel}}
          </view>
        </view>
        <view class="online-member-info">
          <view class="online-member-name-line">
            <text class="online-member-name">{{item.displayName}}</text>
            <text wx:if="{{item.isOwner}}" class="online-owner-badge">房主</text>
          </view>
          <text class="online-member-seat">{{item.directionLabel}}家</text>
        </view>
        <button
          wx:if="{{item.canTransfer}}"
          class="online-transfer-owner-button"
          loading="{{onlineRoomLoading}}"
          disabled="{{onlineRoomLoading}}"
          data-open-id="{{item.openId}}"
          data-display-name="{{item.displayName}}"
          bindtap="handleTransferRoomOwner"
        >
          转让房主
        </button>
      </view>
      <text class="online-member-hint" wx:if="{{workbenchMode === 'room-host'}}">
        转让后，新房主负责编辑与结算，你将变为只读成员
      </text>
      <text class="online-member-hint" wx:else>仅房主可以编辑房间和确认结算</text>
    </view>
  </view>

  <view class="bottom-sheet theme-sheet" wx:if="{{editingPanel === 'scene-yaku'}}">
    <view class="sheet-header">
      <text class="sheet-title">场面番型</text>
    </view>
    <view class="input-tip" wx:if="{{multiRonProgress}}">
      当前结算 {{multiRonCurrentLabel}}，已完成 {{multiRonProgress.completedWins.length}}/{{multiRonProgress.winners.length}}
    </view>
    <view class="scene-section-title">立直状态</view>
    <radio-group class="radio-row" bindchange="handleRiichiStateChange">
      <label class="radio-item" wx:for="{{riichiStateOptions}}" wx:key="key">
        <radio
          value="{{item.key}}"
          checked="{{item.checked}}"
          color="{{activeThemeId === 'maple' ? '#8f3028' : activeThemeId === 'benji' ? '#4d8e70' : '#184c3a'}}"
        />
        <text>{{item.label}}</text>
      </label>
    </radio-group>

    <view class="scene-section-title">特殊和牌方式</view>
    <radio-group class="radio-row timing-radio-row" bindchange="handleTimingConditionChange">
