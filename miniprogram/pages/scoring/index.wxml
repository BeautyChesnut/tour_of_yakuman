          <text class="rules-cell rules-head">中张</text>
          <text class="rules-cell rules-head">幺九/字牌</text>
          <text class="rules-cell">明刻</text>
          <text class="rules-cell">2</text>
          <text class="rules-cell">4</text>
          <text class="rules-cell">暗刻</text>
          <text class="rules-cell">4</text>
          <text class="rules-cell">8</text>
          <text class="rules-cell">明杠</text>
          <text class="rules-cell">8</text>
          <text class="rules-cell">16</text>
          <text class="rules-cell">暗杠</text>
          <text class="rules-cell">16</text>
          <text class="rules-cell">32</text>
          <text class="rules-cell">顺子</text>
          <text class="rules-cell">0</text>
          <text class="rules-cell">0</text>
        </view>
        <text class="rules-line">荣和时，和牌张完成刻子按明刻；自摸时按暗刻。</text>
      </view>
      <view class="rules-section">
        <text class="rules-section-title">限制牌</text>
        <view class="rules-table rules-table-3">
          <text class="rules-cell rules-head">牌值</text>
          <text class="rules-cell rules-head">条件</text>
          <text class="rules-cell rules-head">基本点</text>
          <text class="rules-cell">满贯</text>
          <text class="rules-cell">5 番 / 4 番 40 符+ / 3 番 70 符+</text>
          <text class="rules-cell">2000</text>
          <text class="rules-cell">跳满</text>
          <text class="rules-cell">6-7 番</text>
          <text class="rules-cell">3000</text>
          <text class="rules-cell">倍满</text>
          <text class="rules-cell">8-10 番</text>
          <text class="rules-cell">4000</text>
          <text class="rules-cell">三倍满</text>
          <text class="rules-cell">11-12 番</text>
          <text class="rules-cell">6000</text>
          <text class="rules-cell">役满</text>
          <text class="rules-cell">役满 / 累计役满</text>
          <text class="rules-cell">8000</text>
        </view>
      </view>
      <view class="rules-section">
        <text class="rules-section-title">支付公式</text>
        <text class="rules-line">子家荣和：放铳者支付 ceil100(基本点 × 4)。</text>
        <text class="rules-line">亲家荣和：放铳者支付 ceil100(基本点 × 6)。</text>
        <text class="rules-line">子家自摸：亲家支付 ceil100(基本点 × 2)，其他子家支付 ceil100(基本点)。</text>
        <text class="rules-line">亲家自摸：每个子家支付 ceil100(基本点 × 2)。</text>
        <text class="rules-line">ceil100 表示向上取整到 100 点。</text>
      </view>
      <view class="rules-section">
        <text class="rules-section-title">常见点数速查</text>
        <text class="rules-line">格式：子荣 / 亲荣 / 子自摸 / 亲自摸。子自摸为“子家支付-亲家支付”。</text>
        <view class="rules-table rules-table-5">
          <text class="rules-cell rules-head">番符</text>
          <text class="rules-cell rules-head">子荣</text>
          <text class="rules-cell rules-head">亲荣</text>
          <text class="rules-cell rules-head">子自摸</text>
          <text class="rules-cell rules-head">亲自摸</text>
          <text class="rules-cell">1番30符</text>
          <text class="rules-cell">1000</text>
          <text class="rules-cell">1500</text>
          <text class="rules-cell">300-500</text>
          <text class="rules-cell">500 all</text>
          <text class="rules-cell">2番30符</text>
          <text class="rules-cell">2000</text>
          <text class="rules-cell">2900</text>
          <text class="rules-cell">500-1000</text>
          <text class="rules-cell">1000 all</text>
          <text class="rules-cell">3番30符</text>
          <text class="rules-cell">3900</text>
          <text class="rules-cell">5800</text>
          <text class="rules-cell">1000-2000</text>
          <text class="rules-cell">2000 all</text>
          <text class="rules-cell">4番30符</text>
          <text class="rules-cell">7700</text>
          <text class="rules-cell">11600</text>
          <text class="rules-cell">2000-3900</text>
          <text class="rules-cell">3900 all</text>
          <text class="rules-cell">满贯</text>
          <text class="rules-cell">8000</text>
          <text class="rules-cell">12000</text>
          <text class="rules-cell">2000-4000</text>
          <text class="rules-cell">4000 all</text>
        </view>
      </view>
      <view class="rules-section">
        <text class="rules-section-title">本场、供托与边界</text>
        <text class="rules-line">荣和每本场由放铳者额外支付 300 点；自摸每本场由四麻三家或三麻两家各额外支付 100 点。</text>
        <text class="rules-line">每根供托 1000 点；多人荣和时，积棒和供托按雀魂规则上家取り。</text>
        <text class="rules-line">支持双响、三响；本地三麻默认 35000 点、禁止吃牌，北牌可作字牌或拔北。</text>
        <text class="rules-line">支持大三元、大四喜、四杠子包牌；暂不处理终局马点、返点、排名分和途中流局。</text>
      </view>
      <view class="rules-section rules-feedback-section">
        <text class="rules-section-title">遇到问题</text>
        <text class="rules-line">可直接联系我们反馈，核心算点不会自动上传牌谱或个人资料。</text>
        <button class="feedback-button" open-type="contact">联系反馈</button>
      </view>
    </view>
  </view>

  <view class="bottom-sheet theme-sheet" wx:if="{{editingPanel === 'records'}}">
    <view class="sheet-header">
      <text class="sheet-title">结算记录</text>
    </view>
    <view wx:if="{{!recordRows.length}}" class="empty-state">暂无记录</view>
    <view class="record-row" wx:for="{{recordRows}}" wx:key="id">
      <text class="record-title">{{item.title}}</text>
      <text class="record-detail">{{item.detail}}</text>
    </view>
  </view>

  <view class="confirm-dialog" wx:if="{{editingPanel === 'confirm'}}">
    <view class="confirm-title">确认结算？</view>
    <view class="confirm-line" wx:for="{{confirmationLines}}" wx:key="*this">{{item}}</view>
    <view wx:if="{{confirmationResultLines.length}}" class="confirm-result-lines">
      <view class="confirm-line confirm-result-line" wx:for="{{confirmationResultLines}}" wx:key="*this">
        {{item}}
      </view>
    </view>
    <view class="confirm-actions">
      <button class="secondary-button" bindtap="handleClosePanel">返回修改</button>
      <button class="primary-button" bindtap="handleConfirmSettlement">
        {{multiRonConfirmText}}
      </button>
    </view>
  </view>
</view>
