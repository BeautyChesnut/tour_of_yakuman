.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #0f4d3a 0 96rpx, #f9f6ed 96rpx 100%);
  color: #1f2933;
}

.workbench {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4f6f2;
}

.mode-home {
  min-height: 100vh;
  padding: 0 28rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 22rpx;
}

.mode-hero {
  position: relative;
  width: calc(100% + 56rpx);
  height: 324rpx;
  margin: 0 -28rpx 18rpx;
  overflow: hidden;
  border-radius: 0 0 26rpx 26rpx;
  box-shadow: 0 16rpx 30rpx rgba(15, 23, 42, 0.14);
}

.mode-hero-image {
  display: block;
  width: 100%;
  height: 100%;
}

.mode-action-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-width: none;
  min-width: 0;
  margin: 0 auto;
}

.mode-card {
  width: 100%;
  min-height: 136rpx;
  margin: 0;
  padding: 14rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff9f7;
  color: #1f2933;
  text-align: left;
  line-height: 1;
  box-shadow:
    inset 0 0 0 2rpx rgba(205, 83, 87, 0.18),
    0 10rpx 22rpx rgba(15, 23, 42, 0.1);
}

.mode-card-disabled {
  opacity: 0.7;
}

.mode-card-join {
  background: #f4fff5;
  box-shadow:
    inset 0 0 0 2rpx rgba(84, 169, 100, 0.2),
    0 10rpx 22rpx rgba(15, 23, 42, 0.1);
}

.mode-card-local {
  background: #f4fbff;
  box-shadow:
    inset 0 0 0 2rpx rgba(78, 160, 214, 0.22),
    0 10rpx 22rpx rgba(15, 23, 42, 0.1);
}

.mode-card-icon-wrap {
  display: flex;
  flex: 0 0 116rpx;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 108rpx;
}

.mode-card-icon {
  width: 116rpx;
  height: 104rpx;
  border-radius: 10rpx;
  filter: drop-shadow(0 6rpx 8rpx rgba(15, 23, 42, 0.1));
}

.mode-card-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.mode-card-title,
.mode-card-desc {
  display: block;
  white-space: nowrap;
}

.mode-card-title {
  color: #b02f3c;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.mode-card-join .mode-card-title {
  color: #126c4f;
}

.mode-card-local .mode-card-title {
  color: #1d4d83;
}

.mode-card-desc {
  color: #9f2a2a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.mode-card-join .mode-card-desc {
  color: #2b7256;
}

.mode-card-local .mode-card-desc {
  color: #315f93;
}

.mode-card-arrow {
  display: flex;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #df5362;
  color: #fff;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 50rpx;
}

.mode-card-join .mode-card-arrow {
  background: #5dbb70;
}

.mode-card-local .mode-card-arrow {
  background: #55a7df;
}

.mode-status {
  display: block;
  min-height: 34rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 34rpx;
}

.context-bar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 18rpx;
  min-height: 74rpx;
  padding: 10rpx 22rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #dce3dc;
  background: #fbfcf8;
}

.context-main,
.segmented,
.confirm-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.context-main {
  min-width: 0;
  width: 100%;
  display: flex;
  align-items: center;
  flex-direction: row;
  align-self: center;
  justify-content: flex-start;
  gap: 10rpx;
  text-align: left;
}

.context-line {
  display: flex;
  align-items: center;
  min-width: 0;
  justify-content: flex-start;
}

.context-round-line {
  flex: 1 1 auto;
  min-height: 52rpx;
  gap: 12rpx;
  flex-wrap: nowrap;
}

.context-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-weight: 800;
}

.context-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
  border-radius: 8rpx;
  background: #184c3a;
  color: #fff;
  font-size: 20rpx;
  line-height: 36rpx;
}

.round-label {
  min-width: 0;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.room-exit-trigger {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  height: 52rpx;
  gap: 12rpx;
}

.room-exit-trigger .round-label {
  line-height: 52rpx;
}

.room-exit-text {
  flex: 0 0 auto;
  color: #9f2a2a;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
  white-space: nowrap;
}

.room-home-text {
  flex: 0 0 auto;
  color: #46515f;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
  white-space: nowrap;
}

.context-actions {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: max-content;
  align-items: center;
  gap: 7rpx;
  height: 52rpx;
  justify-content: end;
}

.segment,
.primary-button,
.secondary-button,
.link-button,
.context-tool {
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
}

.primary-button::after,
.secondary-button::after,
.link-button::after,
.context-tool::after {
  border: 0;
}

.context-tool {
  width: 52rpx;
  height: 52rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #e9eee8;
  color: #46515f;
  line-height: 52rpx;
}

.context-tool-wide {
  width: 76rpx;
}

.context-tool-danger {
  color: #9f2a2a;
}

.button-icon-image {
  width: 32rpx;
  height: 32rpx;
}

.context-tool-text {
  font-size: 24rpx;
  font-weight: 800;
}

.button-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 7rpx;
  background: rgba(18, 108, 79, 0.12);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.table-zone {
  position: relative;
  height: 540rpx;
  margin: 10rpx 20rpx 14rpx;
  border-radius: 14rpx;
  background:
    radial-gradient(circle at center, rgba(255, 255, 255, 0.08) 0 24%, transparent 25%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.05) 25%, transparent 25%) 0 0 / 28rpx 28rpx,
    #2d6b58;
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.15),
    inset 0 -14rpx 28rpx rgba(18, 76, 58, 0.24);
}

.table-refresh-button {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 6;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.14);
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.18),
    0 8rpx 16rpx rgba(15, 23, 42, 0.12);
}

.table-refresh-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.92;
}

.seat-card {
  position: absolute;
  width: 196rpx;
  height: 184rpx;
  padding: 8rpx;
  box-sizing: border-box;
  overflow: visible;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.92);
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.12);
}

.seat-north {
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
}

.seat-south {
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
}

.seat-west {
  top: 50%;
  left: 18rpx;
  transform: translateY(-50%);
}

.seat-east {
  top: 50%;
  right: 18rpx;
  transform: translateY(-50%);
}

.seat-heading,
.seat-points,
.seat-rank {
  display: block;
}

.seat-heading {
  position: absolute;
  top: 0;
  left: 0;
  right: 8rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 30rpx;
  gap: 6rpx;
  padding: 0;
  box-sizing: border-box;
  pointer-events: none;
}

.seat-identity {
  display: flex;
  align-items: center;
  gap: 5rpx;
  min-width: 0;
}

.seat-name {
  display: none;
  min-width: 0;
  overflow: hidden;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seat-badges {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 3rpx;
  min-width: 0;
}

.seat-status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 28rpx;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border-radius: 7rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #46515f;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-align: center;
  box-shadow: inset 0 0 0 2rpx rgba(31, 41, 51, 0.08);
}

.seat-status-badge-dealer {
  background: #f5c542;
  color: #493600;
  box-shadow: none;
}

.seat-status-badge-discarder {
  background: #c9342b;
  color: #fff;
  box-shadow: none;
}

.seat-status-badge-winner {
  background: #fff1b8;
  color: #7a4b00;
  box-shadow: inset 0 0 0 2rpx rgba(122, 75, 0, 0.08);
}

.seat-status-badge-tenpai {
  background: #dff3eb;
  color: #126c4f;
  box-shadow: inset 0 0 0 2rpx rgba(18, 108, 79, 0.08);
}

.seat-avatar-wrap {
  position: relative;
  width: 100%;
  height: 112rpx;
  margin-top: 0;
  padding-top: 30rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #fff;
}

.seat-avatar {
  display: block;
  width: 64%;
  height: auto;
  margin: 0 auto;
  transform: translateY(-14rpx);
  transform-origin: center top;
}

.seat-avatar-east {
  transform: translateY(-14rpx);
}

.seat-avatar-south {
  transform: translateY(-14rpx);
}

.seat-avatar-west {
  transform: translateY(-14rpx);
}

.seat-avatar-north {
  transform: translateY(-14rpx);
}

.seat-points {
  margin-top: 7rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.seat-rank {
  margin-top: 0;
  color: #667085;
  font-size: 18rpx;
  line-height: 20rpx;
}

.seat-nickname {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #fff;
  color: #184c3a;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 34rpx;
  text-align: center;
  box-shadow: inset 0 0 0 2rpx rgba(24, 76, 58, 0.16);
}

.seat-invite-bar {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 8rpx;
  height: 40rpx;
  box-sizing: border-box;
  border-radius: 6rpx;
  background: #126c4f;
  color: #fff;
  overflow: hidden;
}

.seat-invite-text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: #fff;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-align: center;
  text-overflow: clip;
  white-space: nowrap;
}

.seat-invite-action {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 8rpx;
  z-index: 3;
  height: 40rpx;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  background: transparent;
  font-size: 0;
  line-height: 0;
}

.seat-invite-action::after {
  border: 0;
}

.is-empty-online-seat {
  opacity: 0.78;
}

.is-empty-online-seat .seat-avatar-wrap {
  height: 126rpx;
}

.is-empty-online-seat .seat-avatar {
  filter: grayscale(1);
  opacity: 0.6;
}

.is-dealer {
  border-color: #e0a800;
}

.is-riichi {
  border-color: #c9342b;
  box-shadow:
    0 8rpx 18rpx rgba(15, 23, 42, 0.12),
    0 0 0 4rpx rgba(201, 52, 43, 0.18);
}

.is-winner {
  background: #fff9df;
  box-shadow:
    0 8rpx 18rpx rgba(15, 23, 42, 0.12),
    0 0 0 4rpx rgba(245, 197, 66, 0.22);
}

.is-current-winner {
  box-shadow:
    0 8rpx 18rpx rgba(15, 23, 42, 0.12),
    0 0 0 5rpx rgba(18, 108, 79, 0.26);
}

.is-discarder {
  background: #fff1f0;
}

.table-center {
  position: absolute;
  z-index: 4;
  top: 50%;
  left: 50%;
  width: 172rpx;
  min-height: 96rpx;
  padding: 10rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transform: translate(-50%, -50%);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 10rpx;
  background: rgba(17, 73, 58, 0.76);
  color: #fff;
  font-size: 21rpx;
  line-height: 28rpx;
  text-align: center;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.2);
}

.table-center text {
  display: block;
  white-space: nowrap;
}

.settlement-zone {
  flex: 1;
  padding: 0 0 24rpx;
}

.summary-row,
.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 78rpx;
  padding: 0 18rpx;
  border-bottom: 1rpx solid #dce3dc;
  background: #fff;
}

.summary-row {
  margin: 0 20rpx;
}

.summary-row:first-child {
  border-radius: 8rpx 8rpx 0 0;
}

.summary-row-multiline {
  align-items: center;
  padding-top: 10rpx;
  padding-bottom: 10rpx;
}

.summary-row-tiles {
  align-items: center;
  padding-top: 0;
  padding-bottom: 0;
}

.summary-row-last {
  border-radius: 0 0 8rpx 8rpx;
}

.situation-analysis-card {
  margin: 18rpx 20rpx 0;
  padding: 20rpx;
  border: 1rpx solid #dce3dc;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.06);
}

.situation-analysis-card-actionable {
  border-color: #c8ddd1;
}

.situation-analysis-card-actionable:active {
  background: #f7fbf8;
}

.situation-analysis-header,
.situation-analysis-heading {
  display: flex;
  align-items: center;
}

.situation-analysis-header {
  justify-content: space-between;
  gap: 16rpx;
}

.situation-analysis-heading {
  gap: 10rpx;
}

.situation-analysis-title {
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 800;
}

.situation-analysis-badge {
  padding: 3rpx 9rpx;
  border-radius: 6rpx;
  background: #e4f1ea;
  color: #126c4f;
  font-size: 18rpx;
  font-weight: 700;
}

.situation-analysis-rank {
  color: #126c4f;
  font-size: 22rpx;
  font-weight: 800;
}

.situation-analysis-meta {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 30rpx;
}

.situation-analysis-section {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf0ec;
}

.situation-analysis-section-title {
  display: block;
  color: #46515f;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 32rpx;
}

.situation-analysis-line {
  display: block;
  margin-top: 6rpx;
  color: #1f2933;
  font-size: 22rpx;
  line-height: 32rpx;
}

.situation-analysis-summary {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf0ec;
}

.situation-analysis-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #126c4f;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.situation-analysis-link-chevron {
  font-size: 38rpx;
  line-height: 34rpx;
}

.situation-analysis-empty {
  padding: 24rpx 0 10rpx;
  color: #7b857f;
  font-size: 22rpx;
  text-align: center;
}

.situation-analysis-note {
  display: block;
  margin-top: 16rpx;
  color: #8b968f;
  font-size: 18rpx;
  line-height: 28rpx;
}

.summary-title {
  flex: 0 0 140rpx;
  color: #46515f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.summary-title-wrap {
  display: flex;
  flex: 0 0 140rpx;
  align-items: center;
}

.summary-title-wrap .summary-title {
  flex: 1;
}

.summary-icon,
.summary-chevron,
.context-tool-label {
  display: none;
}

.summary-value {
  flex: 1;
  color: #1f2933;
  font-size: 24rpx;
  text-align: right;
}

.summary-row-warning .summary-value {
  color: #b42318;
  font-weight: 700;
}

.summary-value-lines {
  display: flex;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
  line-height: 30rpx;
}

.summary-value-line {
  display: block;
}

.summary-value-tiles {
  display: flex;
  min-width: 0;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: flex-end;
  gap: 8rpx 14rpx;
}

.summary-tile-section {
  display: flex;
  flex: 0 0 auto;
  min-width: max-content;
  max-width: 100%;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.summary-tile-label {
  flex: 0 0 auto;
  color: #46515f;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.summary-tile-list {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 6rpx;
}

.summary-tile {
  flex: 0 0 30rpx;
  width: 30rpx;
  height: 48rpx;
}

.summary-tile-empty {
  color: #8b968f;
  font-size: 22rpx;
  line-height: 34rpx;
}

.multi-ron-bar {
  margin: 14rpx 20rpx 0;
  padding: 12rpx;
  border: 1rpx solid #dce8dd;
  border-radius: 8rpx;
  background: #f7faf6;
  color: #46515f;
  font-size: 22rpx;
}

.multi-ron-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}

.compact-button {
  flex: 1;
  height: 52rpx;
  font-size: 22rpx;
  line-height: 52rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: rgba(20, 30, 38, 0.38);
}

.bottom-sheet {
  position: fixed;
  left: 50%;
  top: 50%;
  z-index: 20;
  width: calc(100vw - 48rpx);
  max-height: 78vh;
  padding: 22rpx;
  overflow-y: auto;
  transform: translate(-50%, -50%);
  border-radius: 12rpx;
  background: #fbfcf8;
  box-shadow: 0 18rpx 60rpx rgba(15, 23, 42, 0.24);
  box-sizing: border-box;
}

.tile-sheet {
  max-height: 86vh;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.sheet-title {
  display: block;
  font-size: 30rpx;
