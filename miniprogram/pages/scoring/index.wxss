.theme-option {
  display: grid;
  grid-template-columns: 154rpx minmax(0, 1fr) 74rpx;
  align-items: center;
  gap: 16rpx;
  min-height: 116rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border: 2rpx solid #dce3dc;
  border-radius: 8rpx;
  background: #fff;
