.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.summary {
  border-radius: 8rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.summary-pass {
  background: #126c4f;
}

.summary-fail {
  background: #9f2a2a;
}

.summary-title {
  font-size: 34rpx;
  font-weight: 700;
}

.summary-status {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.case-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.case-card {
  background: #fff;
  border: 1rpx solid #e4ded4;
  border-radius: 8rpx;
  padding: 22rpx;
}

.case-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.case-name {
  font-size: 30rpx;
  font-weight: 700;
}

.case-status {
  flex: none;
  font-size: 24rpx;
}

.pass {
  color: #126c4f;
}

.fail {
  color: #9f2a2a;
}

.case-input,
.case-result,
.failure {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.case-input {
  color: #586474;
}

.case-result {
  color: #1f2933;
}

.case-failures {
  margin-top: 10rpx;
}

.failure {
  color: #9f2a2a;
}
