<view class="page">
  <view class="summary {{allPassed ? 'summary-pass' : 'summary-fail'}}">
    <view class="summary-title">riichi 小程序兼容验证</view>
    <view class="summary-status">{{allPassed ? "全部通过" : "存在失败"}}</view>
  </view>

  <view class="case-list">
    <view wx:for="{{results}}" wx:key="name" class="case-card">
      <view class="case-header">
        <text class="case-name">{{item.name}}</text>
        <text class="case-status {{item.passed ? 'pass' : 'fail'}}">
          {{item.passed ? "通过" : "失败"}}
        </text>
      </view>
      <view class="case-input">{{item.input}}</view>
      <view class="case-result">{{item.actual.text}}</view>
      <view wx:if="{{!item.passed}}" class="case-failures">
        <view wx:for="{{item.failures}}" wx:key="*this" class="failure">{{item}}</view>
      </view>
    </view>
  </view>
</view>
